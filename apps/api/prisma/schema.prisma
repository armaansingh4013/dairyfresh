generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum PlanMode {
  EVERYDAY
  CUSTOM
}

enum PlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  MISSED
  CANCELLED
}

enum InvoiceStatus {
  DUE
  PAID
  OVERDUE
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
}

model User {
  id          String   @id @default(cuid())
  role        UserRole @default(CUSTOMER)
  phone       String   @unique
  email       String?  @unique
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  addresses   Address[]
  plans       Plan[]
  deliveries  Delivery[]
  invoices    Invoice[]
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  title       String
  line1       String
  line2       String?
  landmark    String?
  city        String
  state       String
  postalCode  String
  lat         Float?
  lng         Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  deliveries  Delivery[]
  planDays    PlanDay[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  unit        String   @default("L")
  price       Float
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plans       Plan[]
  deliveries  Delivery[]
}

model Plan {
  id              String     @id @default(cuid())
  userId          String
  productId       String
  startDate       DateTime
  endDate         DateTime
  mode            PlanMode
  defaultQuantity Float
  status          PlanStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id])
  product         Product    @relation(fields: [productId], references: [id])
  days            PlanDay[]
  pauses          PlanPause[]
  deliveries      Delivery[]
}

model PlanDay {
  id         String   @id @default(cuid())
  planId     String
  date       DateTime
  quantity   Float
  addressId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  plan       Plan     @relation(fields: [planId], references: [id])
  address    Address? @relation(fields: [addressId], references: [id])

  @@unique([planId, date], name: "planId_date")
}

model PlanPause {
  id         String   @id @default(cuid())
  planId     String
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  plan       Plan     @relation(fields: [planId], references: [id])
}

model Delivery {
  id          String         @id @default(cuid())
  userId      String
  addressId   String
  productId   String
  planId      String?
  date        DateTime
  quantity    Float
  status      DeliveryStatus @default(PENDING)
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id])
  address     Address        @relation(fields: [addressId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
  plan        Plan?          @relation(fields: [planId], references: [id])

  @@unique([userId, date, productId], name: "userId_date_productId")
}

model Invoice {
  id          String        @id @default(cuid())
  userId      String
  month       Int
  year        Int
  totalAmount Float
  status      InvoiceStatus @default(DUE)
  pdfUrl      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id])
  payments    Payment[]

  @@unique([userId, month, year], name: "userId_month_year")
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  provider    String
  amount      Float
  status      PaymentStatus
  reference   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
}
